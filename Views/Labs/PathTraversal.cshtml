@{
    ViewData["Title"] = "Path Traversal Lab";
    var mode = ViewData["Mode"]?.ToString();
    var file = ViewData["File"]?.ToString() ?? string.Empty;
    var resolvedPath = ViewData["ResolvedPath"]?.ToString();
    var result = ViewData["Result"]?.ToString();
    var content = ViewData["Content"]?.ToString();
}

<section class="hero-panel">
    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
        <div>
            <span class="eyebrow">LAB 12 - WEB SECURITY</span>
            <h1 class="display-5 fw-bold mt-2 mb-3">Path Traversal</h1>
            <p class="lead mb-2">
                Dosya adi dogrulanmadan path'e eklendiginde <code>../</code> ile kok disina cikilabilir. Normalize ve root kisiti ile engelle.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <span class="chip">Intermediate</span>
                <span class="chip">LFI</span>
                <span class="chip">Path Canonicalization</span>
            </div>
        </div>
        <a class="btn btn-outline-light" asp-controller="Home" asp-action="Index">Ana Sayfaya Don</a>
    </div>
</section>

<section class="mt-4">
    <div class="row g-3">
        <div class="col-lg-8">
            <article class="lab-card h-100">
                <h2 class="h4 mb-3">Dosya Okuma Demo</h2>
                <p class="text-muted mb-3">
                    Izinli klasor: <code>App_Data/lab-files/</code> (<code>welcome.txt</code>, <code>notes.txt</code>).
                    Gizli hedef: <code>App_Data/secrets/flag.txt</code>
                </p>

                <form class="row g-2" method="post" asp-controller="PathTraversalLab" asp-action="Vulnerable">
                    <div class="col-sm-8">
                        <input class="form-control" type="text" name="file" placeholder="ornek: welcome.txt veya ../secrets/flag.txt" />
                    </div>
                    <div class="col-sm-4 d-grid">
                        <button class="btn btn-primary" type="submit">Oku (Vulnerable)</button>
                    </div>
                </form>

                <form class="row g-2 mt-2" method="post" asp-controller="PathTraversalLab" asp-action="Secure">
                    <div class="col-sm-8">
                        <input class="form-control" type="text" name="file" placeholder="ornek: welcome.txt" />
                    </div>
                    <div class="col-sm-4 d-grid">
                        <button class="btn btn-success" type="submit">Oku (Secure)</button>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(mode))
                {
                    <div class="mt-3 p-3 rounded-3 border border-warning">
                        <p class="mb-1"><strong>Mod:</strong> @mode</p>
                        <p class="mb-1"><strong>Girdi:</strong> <code>@file</code></p>
                        @if (!string.IsNullOrWhiteSpace(resolvedPath))
                        {
                            <p class="mb-1"><strong>Cozulen Path:</strong> <code>@resolvedPath</code></p>
                        }
                        <p class="mb-0"><strong>Sonuc:</strong> @result</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(content))
                    {
                        <div class="mt-3 p-3 rounded-3 border border-secondary-subtle">
                            <p class="mb-2"><strong>Dosya Icerigi</strong></p>
                            <pre class="mb-0">@content</pre>
                        </div>
                    }
                }

                <div class="mt-3 p-3 rounded-3 border border-secondary-subtle">
                    <strong class="d-block mb-2">Test Payloadlari</strong>
                    <code>welcome.txt</code>,
                    <code>../secrets/flag.txt</code>,
                    <code>..\\secrets\\flag.txt</code>
                </div>
            </article>
        </div>

        <div class="col-lg-4">
            <article class="lab-card h-100">
                <h2 class="h5 mb-3">Ogrenme Hedefleri</h2>
                <ul class="mb-0 ps-3">
                    <li><code>../</code> ile dizin disina cikmayi gormek</li>
                    <li>Path normalize / canonicalization anlamak</li>
                    <li>Root prefix kontrolu uygulamak</li>
                    <li>Allowlist dosya adi ile guvenli okuma</li>
                </ul>
            </article>
        </div>
    </div>
</section>

<section class="mt-4">
    <div class="row g-3">
        <div class="col-lg-6">
            <article class="lab-card h-100">
                <h2 class="h5 mb-3">Bu Hata Neden Olustu?</h2>
                <ul class="mb-0 ps-3">
                    <li>Kullanici girdisi dogrudan path birlestirmeye eklendi.</li>
                    <li><code>..</code> ve ayirici karakterler filtrelenmedi.</li>
                    <li>lab-files disindaki secret dosyasi okunabildi.</li>
                </ul>
            </article>
        </div>
        <div class="col-lg-6">
            <article class="lab-card h-100">
                <h2 class="h5 mb-3">Nasil Cozuldu?</h2>
                <ol class="mb-0 ps-3">
                    <li>Traversal karakterleri reddedildi.</li>
                    <li><code>GetFullPath</code> ile yol normalize edildi.</li>
                    <li>Sonuc yolunun lab-files altinda oldugu dogrulandi.</li>
                </ol>
            </article>
        </div>
    </div>
</section>

<section class="mt-4">
    <article class="lab-card">
        <h2 class="h5 mb-3">Adim Adim Yol Haritasi</h2>
        <div class="workflow-steps">
            <article class="step-card"><span>01</span> Normal dosyayi oku</article>
            <article class="step-card"><span>02</span> ../secrets/flag.txt dene</article>
            <article class="step-card"><span>03</span> Kok nedeni analiz et</article>
            <article class="step-card"><span>04</span> Path kisiti ekle</article>
            <article class="step-card"><span>05</span> Secure akista retest</article>
            <article class="step-card"><span>06</span> Allowlist yaklasimini not et</article>
        </div>
    </article>
</section>
