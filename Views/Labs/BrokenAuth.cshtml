@{
    ViewData["Title"] = "Broken Authentication Lab";
    var mode = ViewData["Mode"]?.ToString();
    var username = ViewData["Username"]?.ToString() ?? string.Empty;
    var result = ViewData["Result"]?.ToString();
    var attempts = ViewData["Attempts"]?.ToString();
}

<section class="hero-panel">
    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
        <div>
            <span class="eyebrow">LAB 14 - WEB SECURITY</span>
            <h1 class="display-5 fw-bold mt-2 mb-3">Broken Authentication</h1>
            <p class="lead mb-2">
                Zayif parola, ayirt edici hata mesaji ve rate limit eksikligi brute-force'u kolaylastirir. Guclu parola + jenerik hata + kilit ile engelle.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <span class="chip">Intermediate</span>
                <span class="chip">AuthN</span>
                <span class="chip">Rate Limiting</span>
            </div>
        </div>
        <a class="btn btn-outline-light" asp-controller="Home" asp-action="Index">Ana Sayfaya Don</a>
    </div>
</section>

<section class="mt-4">
    <div class="row g-3">
        <div class="col-lg-8">
            <article class="lab-card h-100">
                <h2 class="h4 mb-3">Login Demo</h2>
                <p class="text-muted mb-3">
                    Hedef kullanici: <code>admin</code>. Vulnerable: <code>admin</code> / <code>123456</code> de kabul eder.
                    Secure: yalnizca <code>S3cure!Pass</code> ve 3 denemeden sonra kilit.
                </p>

                <form class="row g-2" method="post" asp-controller="BrokenAuthLab" asp-action="Vulnerable">
                    <div class="col-sm-4">
                        <input class="form-control" type="text" name="username" placeholder="username" />
                    </div>
                    <div class="col-sm-4">
                        <input class="form-control" type="password" name="password" placeholder="password" />
                    </div>
                    <div class="col-sm-4 d-grid">
                        <button class="btn btn-primary" type="submit">Giris (Vulnerable)</button>
                    </div>
                </form>

                <form class="row g-2 mt-2" method="post" asp-controller="BrokenAuthLab" asp-action="Secure">
                    <div class="col-sm-4">
                        <input class="form-control" type="text" name="username" placeholder="username" />
                    </div>
                    <div class="col-sm-4">
                        <input class="form-control" type="password" name="password" placeholder="password" />
                    </div>
                    <div class="col-sm-4 d-grid">
                        <button class="btn btn-success" type="submit">Giris (Secure)</button>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(mode))
                {
                    <div class="mt-3 p-3 rounded-3 border border-warning">
                        <p class="mb-1"><strong>Mod:</strong> @mode</p>
                        <p class="mb-1"><strong>Username:</strong> <code>@username</code></p>
                        @if (!string.IsNullOrWhiteSpace(attempts))
                        {
                            <p class="mb-1"><strong>Basarisiz deneme:</strong> <code>@attempts</code></p>
                        }
                        <p class="mb-0"><strong>Sonuc:</strong> @result</p>
                    </div>
                }

                <div class="mt-3 p-3 rounded-3 border border-secondary-subtle">
                    <strong class="d-block mb-2">Test Hesaplari</strong>
                    Vulnerable: <code>admin / admin</code> veya <code>admin / 123456</code>.
                    Secure: <code>admin / S3cure!Pass</code>
                </div>
            </article>
        </div>

        <div class="col-lg-4">
            <article class="lab-card h-100">
                <h2 class="h5 mb-3">Ogrenme Hedefleri</h2>
                <ul class="mb-0 ps-3">
                    <li>Zayif parola politikasinin etkisini gormek</li>
                    <li>User enumeration mesajlarini fark etmek</li>
                    <li>Rate limit / account lockout uygulamak</li>
                    <li>Jenerik hata mesaji kullanmak</li>
                </ul>
            </article>
        </div>
    </div>
</section>

<section class="mt-4">
    <div class="row g-3">
        <div class="col-lg-6">
            <article class="lab-card h-100">
                <h2 class="h5 mb-3">Bu Hata Neden Olustu?</h2>
                <ul class="mb-0 ps-3">
                    <li>Zayif parolalar (<code>admin</code>, <code>123456</code>) kabul edildi.</li>
                    <li>Hata mesaji kullanici/sifre ayirt etti.</li>
                    <li>Basarisiz deneme limiti yoktu.</li>
                </ul>
            </article>
        </div>
        <div class="col-lg-6">
            <article class="lab-card h-100">
                <h2 class="h5 mb-3">Nasil Cozuldu?</h2>
                <ol class="mb-0 ps-3">
                    <li>Yalnizca guclu parola kabul edildi.</li>
                    <li>Jenerik hata mesaji kullanildi.</li>
                    <li>3 basarisiz denemede hesap kilitlendi.</li>
                </ol>
            </article>
        </div>
    </div>
</section>

<section class="mt-4">
    <article class="lab-card">
        <h2 class="h5 mb-3">Adim Adim Yol Haritasi</h2>
        <div class="workflow-steps">
            <article class="step-card"><span>01</span> Vulnerable zayif parola dene</article>
            <article class="step-card"><span>02</span> Enumeration mesajini gozle</article>
            <article class="step-card"><span>03</span> Kok nedeni analiz et</article>
            <article class="step-card"><span>04</span> Guclu parola + rate limit</article>
            <article class="step-card"><span>05</span> Secure akista retest</article>
            <article class="step-card"><span>06</span> MFA / lockout not et</article>
        </div>
    </article>
</section>
